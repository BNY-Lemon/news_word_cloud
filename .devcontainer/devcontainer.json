{
  "name": "news_word_cloud",
  "context": "..",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/app",

  "postCreateCommand": "python -m ipykernel install --user --name=devcontainer && python setup_nltk.py",
  "postStartCommand": "jupyter notebook --ip=0.0.0.0 --allow-root --no-browser --NotebookApp.token=''",

  "forwardPorts": [8888],

  "containerEnv": {
    "MY_API_KEY": "${localEnv:MY_API_KEY}",
    "PYTHONUNBUFFERED": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "features": {}
}
