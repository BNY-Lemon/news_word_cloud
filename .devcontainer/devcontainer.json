{
  "name": "news_word_cloud",
  "context": "..",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/app",

  // Run once after container is created
  "postCreateCommand": "python -m ipykernel install --user --name=devcontainer --display-name 'Python (Dev Container)' && python setup_nltk.py",
  "postStartCommand": "jupyter notebook --ip=0.0.0.0 --allow-root --no-browser --NotebookApp.token=''",

  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],

  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "features": {}
}